# Bu dosyayı .env olarak kopyalayıp kendi değerlerini yaz.
# Buraya SADECE publishable (yayınlanabilir) anahtar konur.
# sb_secret_... / service_role anahtarı ASLA bu projeye girmemeli —
# istemci paketine gömülür ve RLS'i tamamen baypas eder.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
